SECRET_KEY=changeme                  # session signing
DATABASE_URL=sqlite+aiosqlite:///./data/ordertogether.db
TIMEZONE=Europe/Berlin               # IANA timezone for display & deadline input

# Optional OIDC
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=                  # e.g. https://accounts.google.com/.well-known/openid-configuration
OIDC_REDIRECT_URI=http://localhost:8000/auth/callback
OIDC_SSL_VERIFY=true                 # set to "false" for self-signed certs, or path to CA bundle PEM

# Optional features
RECEIPT_UPLOAD_ENABLED=true          # set to "false" to disable receipt/invoice uploads
RECEIPT_TTL_DAYS=7                   # how long uploaded receipts are kept before automatic deletion

# Predefined shops shown in the shop selector on the create-order form (for OIDC users).
# JSON array of {"name": "...", "url": "https://..."} objects, appended after the user's own history.
# PREDEFINED_SHOPS=[{"name":"Pizza Palace","url":"https://pizza.example.com"}]
PREDEFINED_SHOPS=[]
